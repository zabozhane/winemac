#!/bin/zsh
# winemac: run Windows games on Apple Silicon through Wine, one isolated bottle per app.
# Everything (Wine runtime, bottles, caches, logs) lives inside the folder this repo is cloned to.

emulate -L zsh
setopt err_exit no_unset pipe_fail

typeset -r WINEMAC_ROOT=${0:A:h:h}
typeset -r RUNTIME_DIR=$WINEMAC_ROOT/runtime
typeset -r BOTTLES_DIR=$WINEMAC_ROOT/bottles
typeset -r CACHE_DIR=$WINEMAC_ROOT/cache
typeset -r STATE_DIR=$WINEMAC_ROOT/state
typeset -r LOGS_DIR=$WINEMAC_ROOT/logs

# Homebrew disabled its wine casks on 2026-09-01 because they fail the Gatekeeper check,
# so we download the same upstream build (Gcenx/macOS_Wine_builds) directly and pin its hash.
typeset -r WINE_BUILD_URL=https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.0_1/wine-stable-11.0_1-osx64.tar.xz
typeset -r WINE_BUILD_SHA256=b50dc50ec7f41d58b115a6b685d4d1315ba3c797bd3aa0f49213f2703cb82388
typeset -r WINE_BIN_DIR="$RUNTIME_DIR/Wine Stable.app/Contents/Resources/wine/bin"

typeset -ra BREW_PACKAGES=(winetricks)   # pulls cabextract and p7zip, which winetricks needs
typeset -ra DEFAULT_DEPS=(d3dx9 vcrun2005 vcrun2008)
typeset -r BREW_INSTALLED_LIST=$STATE_DIR/brew-installed.txt
typeset -r LAST_RUN_MARKER=$STATE_DIR/last-run.marker
typeset -ra RENDERERS=(gl vulkan)   # wined3d backends; gl is Wine's default

# ---------- output ----------

info() { print -r -- "==> $*" }
warn() { print -ru2 -- "winemac: warning: $*" }
die()  { print -ru2 -- "winemac: error: $*"; exit 1 }

usage() {
  cat <<EOF
Usage: winemac <command> [args]

  setup                         Install Rosetta 2, winetricks (Homebrew) and the pinned Wine build
  doctor                        Check the environment and every bottle
  create  <bottle>              Create an isolated Wine prefix
  deps    <bottle> [verbs...]   Install winetricks verbs (default: ${DEFAULT_DEPS[*]})
  import  <bottle> <dir> <exe>  Copy a game folder into the bottle; <exe> is relative to <dir>
  run     <bottle> [args...]    Launch the imported exe
  stop    <bottle>              Kill every Wine process of the bottle
  renderer <bottle> [gl|vulkan] Print or set the Direct3D backend (applies on next launch)
  server attach <bottle> <dir>  Start the docker compose server in <dir> before the bottle runs
  server detach <bottle>        Run the bottle without the server
  server status|up|down         Show component states, start and wait until ready, stop
  server logs [db|login|game]   Last lines of the server logs
  remove  <bottle>              Show what the bottle holds, then delete it with its game and log
  list                          List bottles
  audit                         List files changed in \$HOME outside winemac since the last run
  uninstall                     Show everything winemac created, then delete it

Root: $WINEMAC_ROOT
EOF
}

# ---------- environment isolation ----------

# Redirect every cache/config location Wine, winetricks and Homebrew would put in $HOME.
export_isolated_env() {
  export XDG_CACHE_HOME=$CACHE_DIR/xdg
  export XDG_CONFIG_HOME=$STATE_DIR/xdg-config
  export XDG_DATA_HOME=$STATE_DIR/xdg-data
  export HOMEBREW_CACHE=$CACHE_DIR/homebrew
  export HOMEBREW_LOGS=$LOGS_DIR/homebrew
  export WINETRICKS_LATEST_VERSION_CHECK=disabled
  # winemenubuilder would create launchers and file associations outside the prefix.
  export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
  # Keep Wine's error lines (unhandled exceptions, missing DLLs) but drop the chatty fixme/warn/trace output.
  export WINEDEBUG=${WINEDEBUG:--all,err+all}
  # MoltenVK prints ~170 lines of device info on every launch; errors are all a crash report needs.
  export MVK_CONFIG_LOG_LEVEL=${MVK_CONFIG_LOG_LEVEL:-1}
  export WINE=$WINE_BIN_DIR/wine
  path=("$WINE_BIN_DIR" /opt/homebrew/bin $path)
}

# ---------- bottles ----------

validate_bottle_name() {
  local name=$1
  [[ $name =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || die "invalid bottle name '$name' (use letters, digits, . _ -)"
}

bottle_dir()    { print -r -- "$BOTTLES_DIR/$1" }
bottle_prefix() { print -r -- "$BOTTLES_DIR/$1/prefix" }

# Selects the bottle for the following wine/winetricks calls.
use_bottle() {
  local name=$1
  validate_bottle_name "$name"
  [[ -d $(bottle_prefix "$name") ]] || die "bottle '$name' does not exist (winemac create $name)"
  export WINEPREFIX=$(bottle_prefix "$name")
}

require_wine() {
  [[ -x $WINE ]] || die "Wine is not installed (run: winemac setup)"
}

# ---------- setup ----------

is_apple_silicon() {
  [[ $(uname -s) == Darwin && $(uname -m) == arm64 ]]
}

require_apple_silicon() {
  is_apple_silicon || die "winemac targets macOS on Apple Silicon"
}

rosetta_is_installed() {
  arch -x86_64 /usr/bin/true 2>/dev/null
}

ensure_rosetta() {
  if rosetta_is_installed; then
    info "Rosetta 2: installed"
    return
  fi
  info "Installing Rosetta 2 (the Wine build is x86_64; this is a system component, it lives outside winemac)"
  sudo softwareupdate --install-rosetta --agree-to-license
  rosetta_is_installed || die "Rosetta 2 installation did not succeed"
}

ensure_homebrew() {
  (( $+commands[brew] )) && return
  die 'Homebrew is not installed. Install it from https://brew.sh:
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
then run: winemac setup'
}

# Records only formulae that this setup added, so uninstall never removes the user's own packages.
ensure_brew_packages() {
  local -a before after added
  before=(${(f)"$(brew list --formula -1)"})
  info "Homebrew: installing ${BREW_PACKAGES[*]}"
  brew install --formula $BREW_PACKAGES
  after=(${(f)"$(brew list --formula -1)"})
  added=(${after:|before})
  (( $#added )) && print -rl -- $added >> $BREW_INSTALLED_LIST
  return 0
}

ensure_wine() {
  if [[ -x $WINE ]]; then
    info "Wine: $("$WINE" --version)"
    return
  fi
  local archive=$CACHE_DIR/downloads/${WINE_BUILD_URL:t}
  info "Downloading ${WINE_BUILD_URL:t}"
  curl -fL --retry 3 -o "$archive.part" "$WINE_BUILD_URL"
  local actual_sha256=${$(shasum -a 256 "$archive.part")[1]}
  if [[ $actual_sha256 != $WINE_BUILD_SHA256 ]]; then
    rm -f -- "$archive.part"
    die "checksum mismatch for ${WINE_BUILD_URL:t}: expected $WINE_BUILD_SHA256, got $actual_sha256"
  fi
  mv -- "$archive.part" "$archive"
  info "Extracting into $RUNTIME_DIR"
  tar -xJf "$archive" -C "$RUNTIME_DIR"
  rm -f -- "$archive"
  info "Wine: $("$WINE" --version)"
}

cmd_setup() {
  require_apple_silicon
  ensure_rosetta
  ensure_homebrew
  ensure_brew_packages
  ensure_wine
  info "Setup complete. Next: winemac create <bottle>"
}

# ---------- doctor ----------

typeset -i doctor_failures=0

check() {
  local label=$1; shift
  if "$@" >/dev/null 2>&1; then
    print -r -- "  [ok]   $label"
  else
    print -r -- "  [FAIL] $label"
    doctor_failures+=1
  fi
}

has_command() { (( $+commands[$1] )) }
wine_runs()   { "$WINE" --version }

# Wine links Desktop/Documents/Downloads/... in drive_c/users to the real $HOME on prefix creation.
prefix_has_no_home_links() {
  local prefix=$1 link
  for link in "$prefix"/drive_c/users/*/**/*(N@); do
    [[ $(readlink -- "$link") == $HOME/* ]] && return 1
  done
  return 0
}

prefix_has_no_root_drive()        { [[ ! -e $1/dosdevices/z: ]] }
prefix_disables_winemenubuilder() { grep -q '"winemenubuilder.exe"=""' "$1/user.reg" }

cmd_doctor() {
  print -r -- "System (macOS $(sw_vers -productVersion 2>/dev/null || print unknown))"
  check "Apple Silicon"       is_apple_silicon
  check "Rosetta 2"           rosetta_is_installed
  check "Homebrew"            has_command brew
  check "winetricks"          has_command winetricks
  check "cabextract"          has_command cabextract
  check "Wine runtime"        wine_runs

  local prefix name
  for prefix in $BOTTLES_DIR/*/prefix(N/); do
    name=${prefix:h:t}
    print -r -- "Bottle $name"
    check "no links into \$HOME"           prefix_has_no_home_links "$prefix"
    check "no Z: drive mapped to /"        prefix_has_no_root_drive "$prefix"
    check "winemenubuilder disabled"       prefix_disables_winemenubuilder "$prefix"
    check "exe imported"                   test -f "$(bottle_dir $name)/exe"
  done

  (( doctor_failures == 0 )) || die "$doctor_failures check(s) failed"
  info "All checks passed"
}

# ---------- bottle commands ----------

cmd_create() {
  (( $# == 1 )) || die "usage: winemac create <bottle>"
  local name=$1
  validate_bottle_name "$name"
  require_wine
  local prefix=$(bottle_prefix "$name")
  [[ ! -e $prefix ]] || die "bottle '$name' already exists"
  mkdir -p "$prefix"
  export WINEPREFIX=$prefix

  info "Initialising prefix $prefix"
  "$WINE" wineboot --init
  wineserver -w
  # Persist the override in the registry so the bottle stays safe even if started without winemac.
  "$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v winemenubuilder.exe /t REG_SZ /d '' /f
  # sandbox: replaces links to $HOME with real folders and unmaps Z: (the whole Mac filesystem).
  winetricks -q sandbox
  wineserver -w
  info "Bottle '$name' created. Next: winemac deps $name"
}

cmd_deps() {
  (( $# >= 1 )) || die "usage: winemac deps <bottle> [verbs...]"
  local name=$1; shift
  use_bottle "$name"
  require_wine
  local -a verbs=("$@")
  (( $#verbs )) || verbs=($DEFAULT_DEPS)
  info "Installing into '$name': ${verbs[*]}"
  winetricks -q $verbs
  wineserver -w
}

cmd_import() {
  (( $# == 3 )) || die "usage: winemac import <bottle> <game-dir> <exe-relative-to-game-dir>"
  local name=$1 source_dir=${2:A} exe_relative=$3
  use_bottle "$name"
  [[ -d $source_dir ]] || die "not a directory: $source_dir"
  [[ -f $source_dir/$exe_relative ]] || die "exe not found: $source_dir/$exe_relative"

  local game_dir_relative=Games/${source_dir:t}
  local destination=$WINEPREFIX/drive_c/$game_dir_relative
  [[ ! -e $destination ]] || die "already imported: $destination"

  info "Copying $source_dir -> $destination"
  mkdir -p "${destination:h}"
  ditto "$source_dir" "$destination"
  print -r -- "$game_dir_relative/$exe_relative" > "$(bottle_dir $name)/exe"
  info "Imported. Next: winemac run $name"
}

# The exit status keeps only the low byte of the Windows exit code, so a crash with
# 0xC0000005 (access violation) reaches us as 5.
describe_exit_code() {
  case $1 in
    5)   print -r -- 'probably 0xC0000005, access violation: the game crashed' ;;
    29)  print -r -- 'probably 0xC000001D, illegal instruction' ;;
    253) print -r -- 'probably 0xC00000FD, stack overflow' ;;
    <129-255>) print -r -- "killed by signal $(( $1 - 128 ))" ;;
    *)   print -r -- 'game exited with an error' ;;
  esac
}

cmd_run() {
  (( $# >= 1 )) || die "usage: winemac run <bottle> [args...]"
  local name=$1; shift
  use_bottle "$name"
  require_wine
  local exe_file=$(bottle_dir $name)/exe
  [[ -f $exe_file ]] || die "nothing imported into '$name' (winemac import $name <dir> <exe>)"
  local exe=$WINEPREFIX/drive_c/$(<$exe_file)
  [[ -f $exe ]] || die "exe is missing: $exe"

  load_server_conf
  local with_server=no
  bottle_uses_server "$name" && with_server=yes
  # The client cannot log in without the server, so it is not launched until the server is ready.
  [[ $with_server == yes ]] && server_up

  local log=$LOGS_DIR/$name.log
  touch "$LAST_RUN_MARKER"
  info "Starting $exe (log: $log)"
  # Games such as the L2 client resolve their data files relative to the working directory.
  cd "${exe:h}"
  print -r -- "==> $(date '+%Y-%m-%d %H:%M:%S') start ${exe:t}" >>"$log"
  local -i exit_code=0 started=$SECONDS
  "$WINE" "${exe:t}" "$@" >>"$log" 2>&1 || exit_code=$?
  local summary="$(date '+%Y-%m-%d %H:%M:%S') exit $exit_code after $(( SECONDS - started ))s"
  (( exit_code )) && summary+=" ($(describe_exit_code $exit_code))"
  print -r -- "==> $summary" >>"$log"
  # The server keeps running by default: the game server takes minutes to start.
  if [[ $with_server == yes && ${server_conf[SERVER_STOP_ON_EXIT]} == yes ]]; then
    server_down
  fi
  return $exit_code
}

cmd_stop() {
  (( $# == 1 )) || die "usage: winemac stop <bottle>"
  use_bottle "$1"
  require_wine
  wineserver -k
}

current_renderer() {
  # user.reg is Wine's text dump of HKCU; section headers look like [Software\\Wine\\Direct3D] <timestamp>.
  local value=$(awk -F'"' '
    /^\[/ { in_section = ($0 ~ /^\[Software\\\\Wine\\\\Direct3D\]/) }
    in_section && $2 == "renderer" { print $4 }
  ' "$WINEPREFIX/user.reg")
  print -r -- ${value:-gl}
}

cmd_renderer() {
  (( $# == 1 || $# == 2 )) || die "usage: winemac renderer <bottle> [${(j:|:)RENDERERS}]"
  use_bottle "$1"
  require_wine
  if (( $# == 1 )); then
    current_renderer
    return
  fi
  local renderer=$2
  (( ${RENDERERS[(Ie)$renderer]} )) || die "unknown renderer '$renderer' (expected: ${RENDERERS[*]})"
  # No wineserver -w: a running game would block it; the value is read at the next Direct3D start.
  "$WINE" reg add 'HKCU\Software\Wine\Direct3D' /v renderer /t REG_SZ /d "$renderer" /f
}

cmd_list() {
  local dir exe
  for dir in $BOTTLES_DIR/*(N/); do
    exe=-
    [[ -f $dir/exe ]] && exe=$(<$dir/exe)
    print -r -- "${dir:t}  $exe"
  done
}

cmd_audit() {
  [[ -f $LAST_RUN_MARKER ]] || die "no run recorded yet (winemac run <bottle>)"
  info "Files in \$HOME changed since the last run, outside $WINEMAC_ROOT:"
  info "(macOS itself writes to ~/Library all the time; look for Wine/winetricks related paths)"
  # Permission errors from privacy-protected folders are expected and not relevant here.
  find "$HOME" -path "$WINEMAC_ROOT" -prune -o \( -type f -o -type l \) -newer "$LAST_RUN_MARKER" -print 2>/dev/null || true
}

# ---------- local server ----------

# The game server is a separate docker compose project (e.g. ~/Projects/l2aiserver); winemac only
# starts it before a linked bottle runs and reports its state. It never removes containers or volumes.
typeset -r SERVER_CONF=$STATE_DIR/server.conf
typeset -r SERVER_READY_LINE='Registered as server'   # printed by the aCis game server once login accepts it
typeset -ri SERVER_POLL_SECONDS=2
typeset -ri ENGINE_START_TIMEOUT=60
typeset -ra SERVER_COMPONENTS=(docker mariadb login game ollama)

typeset -gA server_conf
typeset -g DOCKER_BIN=''

load_server_conf() {
  server_conf=(SERVER_DIR '' SERVER_BOTTLES '' SERVER_START_TIMEOUT 300 SERVER_STOP_ON_EXIT no)
  [[ -f $SERVER_CONF ]] || return 0
  local line
  # Parsed as key=value rather than sourced, so the file can never run code.
  for line in ${(f)"$(<$SERVER_CONF)"}; do
    [[ $line =~ '^[A-Z_]+=' ]] && server_conf[${line%%=*}]=${line#*=}
  done
  return 0
}

save_server_conf() {
  local key
  for key in ${(ok)server_conf}; do
    print -r -- "$key=${server_conf[$key]}"
  done > $SERVER_CONF
}

bottle_uses_server() {
  (( ${${(s: :)server_conf[SERVER_BOTTLES]}[(Ie)$1]} ))
}

# Apps started from Finder do not get the shell's PATH, so the usual install locations are probed.
find_docker() {
  local candidate
  for candidate in ${DOCKER:-} $HOME/.orbstack/bin/docker /usr/local/bin/docker /opt/homebrew/bin/docker; do
    [[ -x $candidate ]] && { print -r -- $candidate; return 0 }
  done
  return 1
}

# Sets DOCKER_BIN; Docker's credential helpers and compose plugin live next to it.
use_docker() {
  DOCKER_BIN=$(find_docker) || die "docker CLI not found (install OrbStack or set DOCKER=/path/to/docker)"
  path=("${DOCKER_BIN:h}" $path)
}

require_server_dir() {
  [[ -n ${server_conf[SERVER_DIR]} ]] || die "no server attached (winemac server attach <bottle> <dir>)"
  [[ -d ${server_conf[SERVER_DIR]} ]] || die "server folder is missing: ${server_conf[SERVER_DIR]}"
}

compose() { (cd "${server_conf[SERVER_DIR]}" && "$DOCKER_BIN" compose "$@") }

engine_is_running() { "$DOCKER_BIN" info >/dev/null 2>&1 }

ensure_engine() {
  engine_is_running && return 0
  local app
  for app in OrbStack Docker; do
    [[ -d /Applications/$app.app ]] || continue
    info "Starting $app"
    open -ga $app
    local -i waited=0
    until engine_is_running; do
      (( waited >= ENGINE_START_TIMEOUT )) && die "$app did not start within ${ENGINE_START_TIMEOUT}s"
      sleep 1
      (( waited += 1 ))
    done
    return 0
  done
  die "Docker is not running and neither OrbStack nor Docker Desktop is in /Applications"
}

# The login server greets every new connection with an Init packet, so a byte received means it is ready.
# A published port can accept the connection before Java listens, which is why the bare connect is not enough.
login_greets() {
  zmodload zsh/net/tcp zsh/system
  ztcp 127.0.0.1 2106 2>/dev/null || return 1
  local -i fd=$REPLY
  local byte
  local -i read_status=0
  sysread -t 2 -s 1 -i $fd byte 2>/dev/null || read_status=$?
  ztcp -c $fd
  return $read_status
}

game_registered() {
  local container=$1 started
  started=$("$DOCKER_BIN" inspect -f '{{.State.StartedAt}}' $container 2>/dev/null) || return 1
  # Captured instead of piped into grep -q, which would break the pipe under pipe_fail.
  local output=$("$DOCKER_BIN" logs --since "$started" $container 2>&1)
  [[ $output == *$SERVER_READY_LINE* ]]
}

# Prints one "component<TAB>state<TAB>detail" line per component.
# States: ready, starting, stopped, failed, unavailable (not configured or Docker is off).
server_status_lines() {
  local -A state detail
  local component
  for component in $SERVER_COMPONENTS; do
    state[$component]=unavailable detail[$component]=''
  done

  if [[ -z ${server_conf[SERVER_DIR]} ]]; then
    for component in $SERVER_COMPONENTS; do detail[$component]='no server attached'; done
  elif [[ ! -d ${server_conf[SERVER_DIR]} ]]; then
    detail[docker]="server folder is missing: ${server_conf[SERVER_DIR]}"
  elif ! DOCKER_BIN=$(find_docker); then
    detail[docker]='docker CLI not found'
  elif ! engine_is_running; then
    state[docker]=stopped
  else
    state[docker]=ready
    state[mariadb]=stopped state[login]=stopped state[game]=stopped

    local line service container_state health exit_code name
    local -A container_of
    # One container per service; --all keeps exited ones so a crash shows as failed, not stopped.
    for line in ${(f)"$(compose ps --all --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}|{{.Name}}' 2>/dev/null)"}; do
      IFS='|' read -r service container_state health exit_code name <<< "$line"
      component=$service
      [[ $service == db ]] && component=mariadb
      if [[ $service == db-init ]]; then
        if [[ $container_state == exited && $exit_code != 0 ]]; then
          state[mariadb]=failed detail[mariadb]="db-init exited with code $exit_code"
        fi
        continue
      fi
      (( ${SERVER_COMPONENTS[(Ie)$component]} )) || continue
      [[ $state[$component] == failed ]] && continue
      container_of[$component]=$name
      case $container_state in
        running)
          state[$component]=starting
          [[ $health == unhealthy ]] && state[$component]=failed detail[$component]=unhealthy ;;
        restarting) state[$component]=starting detail[$component]='restarting after a crash' ;;
        exited|dead)
          state[$component]=stopped
          # 143/137: SIGTERM/SIGKILL from docker compose stop, i.e. stopped on purpose.
          [[ $exit_code == (0|137|143) ]] || state[$component]=failed detail[$component]="exited with code $exit_code" ;;
        *) state[$component]=stopped ;;
      esac
    done

    if [[ $state[mariadb] == starting ]]; then
      case $(compose ps --format '{{.Health}}' db 2>/dev/null) in
        healthy) state[mariadb]=ready ;;
        '') state[mariadb]=ready ;;   # no healthcheck defined: running is all we know
      esac
    fi
    [[ $state[login] == starting ]] && login_greets && state[login]=ready
    [[ $state[game] == starting ]] && game_registered ${container_of[game]} && state[game]=ready
    # Ollama has no readiness probe yet: a running container is taken as ready.
    [[ $state[ollama] == starting ]] && state[ollama]=ready
    [[ -n ${container_of[ollama]:-} ]] || detail[ollama]='not configured'
  fi

  for component in $SERVER_COMPONENTS; do
    print -r -- "$component	${state[$component]}	${detail[$component]}"
  done
}

server_up() {
  require_server_dir
  use_docker
  ensure_engine
  info "Starting the server in ${server_conf[SERVER_DIR]}"
  # Builds the image on the first start; waits for the database and its init job by itself.
  compose up -d

  local -i timeout=${server_conf[SERVER_START_TIMEOUT]} waited=0
  local -A last_state
  local line component state detail
  while true; do
    local -i pending=0
    for line in ${(f)"$(server_status_lines)"}; do
      IFS=$'\t' read -r component state detail <<< "$line"
      [[ $component == (docker|ollama) ]] && continue
      if [[ ${last_state[$component]:-} != $state ]]; then
        info "$component: $state${detail:+ ($detail)}"
        last_state[$component]=$state
      fi
      case $state in
        ready) ;;
        failed)
          local service=$component
          [[ $component == mariadb ]] && service=db
          [[ $detail == db-init* ]] && service=db-init
          compose logs --tail 20 $service || true
          die "$component failed to start" ;;
        *) (( pending += 1 )) ;;
      esac
    done
    (( pending == 0 )) && break
    (( waited >= timeout )) && die "server not ready after ${timeout}s (see: winemac server logs)"
    sleep $SERVER_POLL_SECONDS
    (( waited += SERVER_POLL_SECONDS ))
  done
  info "Server is ready"
}

server_down() {
  require_server_dir
  use_docker
  engine_is_running || { info "Docker is not running; nothing to stop"; return 0 }
  info "Stopping the server (containers and data are kept)"
  compose stop
}

cmd_server() {
  (( $# >= 1 )) || die "usage: winemac server attach|detach|status|up|down|logs"
  local subcommand=$1; shift
  load_server_conf
  case $subcommand in
    attach)
      (( $# == 2 )) || die "usage: winemac server attach <bottle> <server-dir>"
      local name=$1 dir=${2:A}
      use_bottle "$name"
      [[ -f $dir/docker-compose.yml || -f $dir/compose.yaml || -f $dir/compose.yml || -f $dir/docker-compose.yaml ]] \
        || die "no docker compose file in $dir"
      if [[ -n ${server_conf[SERVER_DIR]} && ${server_conf[SERVER_DIR]} != $dir ]]; then
        warn "replacing server ${server_conf[SERVER_DIR]} with $dir for every attached bottle"
      fi
      server_conf[SERVER_DIR]=$dir
      local -a bottles=(${(s: :)server_conf[SERVER_BOTTLES]} $name)
      server_conf[SERVER_BOTTLES]=${(j: :)${(u)bottles}}
      save_server_conf
      info "Bottle '$name' now starts the server in $dir before the game (config: $SERVER_CONF)" ;;
    detach)
      (( $# == 1 )) || die "usage: winemac server detach <bottle>"
      local -a bottles=(${(s: :)server_conf[SERVER_BOTTLES]})
      server_conf[SERVER_BOTTLES]=${(j: :)bottles:#$1}
      save_server_conf
      info "Bottle '$1' no longer starts the server" ;;
    status)
      (( $# == 0 )) || die "usage: winemac server status"
      server_status_lines ;;
    up)
      (( $# == 0 )) || die "usage: winemac server up"
      server_up ;;
    down)
      (( $# == 0 )) || die "usage: winemac server down"
      server_down ;;
    logs)
      (( $# <= 1 )) || die "usage: winemac server logs [db|login|game]"
      require_server_dir
      use_docker
      compose logs --tail 100 "$@" ;;
    *) die "unknown server command: $subcommand" ;;
  esac
}

# ---------- removal ----------

# Deletions go to the Trash so a wrong click can be undone with Finder's Put Back.
# /usr/bin/trash ships with macOS 15 and later.
require_trash() {
  [[ -x /usr/bin/trash ]] || die "/usr/bin/trash not found (needs macOS 15+); nothing was deleted"
}

move_to_trash() { /usr/bin/trash -- "$@" }

# Reads the answer from stdin, so the app can confirm by writing "y".
confirmed() {
  local answer
  read -r "answer?$1 [y/N] "
  [[ $answer == [yY] ]]
}

cmd_remove() {
  (( $# == 1 )) || die "usage: winemac remove <bottle>"
  local name=$1
  use_bottle "$name"
  require_trash
  local dir=$(bottle_dir "$name") log=$LOGS_DIR/$name.log

  print -r -- "This will move to the Trash bottle '$name':"
  du -sh -- "$dir" | sed 's/^/  /'
  [[ -f $dir/exe ]] && print -r -- "  game inside it: C:/$(<$dir/exe)"
  [[ -f $log ]] && print -r -- "  log: $log"
  print -r -- "Not touched: the Wine runtime, other bottles, the winetricks download cache."
  confirmed "Delete bottle '$name'?" || { info "Cancelled"; return 0 }

  if [[ -x $WINE ]]; then
    # wineserver -k fails when no server is running for the prefix, which is the normal case.
    wineserver -k 2>/dev/null || true
  fi
  local -a targets=("$dir")
  [[ -f $log ]] && targets+=("$log")
  move_to_trash $targets
  info "Moved bottle '$name' to the Trash"
}


recorded_brew_packages() {
  [[ -f $BREW_INSTALLED_LIST ]] || return 0
  local package
  for package in ${(fu)"$(<$BREW_INSTALLED_LIST)"}; do
    brew list --formula "$package" >/dev/null 2>&1 && print -r -- "$package"
  done
  return 0
}

stop_all_bottles() {
  [[ -x $WINE ]] || return 0
  local prefix
  for prefix in $BOTTLES_DIR/*/prefix(N/); do
    # wineserver -k fails when no server is running for the prefix, which is the normal case.
    WINEPREFIX=$prefix wineserver -k 2>/dev/null || true
  done
}

cmd_uninstall() {
  [[ -x $WINEMAC_ROOT/bin/winemac && $WINEMAC_ROOT != $HOME && $WINEMAC_ROOT != / ]] \
    || die "refusing to delete unexpected root: $WINEMAC_ROOT"
  require_trash

  local -a packages=(${(f)"$(recorded_brew_packages)"})
  print -r -- "This will move to the Trash:"
  du -sh -- $WINEMAC_ROOT/*(DN) | sed 's/^/  /'
  (( $#packages )) && print -r -- "  Homebrew formulae installed by winemac: ${packages[*]}"
  print -r -- "Not touched: Homebrew itself and Rosetta 2 (system components)."

  confirmed "Delete everything listed above?" || { info "Cancelled"; return 0 }

  stop_all_bottles
  if (( $#packages )); then
    brew uninstall --formula $packages || die "brew uninstall failed; nothing else was deleted"
  fi
  cd /
  move_to_trash "$WINEMAC_ROOT"
  info "Moved $WINEMAC_ROOT to the Trash"
}

# ---------- entry point ----------

main() {
  (( $# )) || { usage; exit 1 }
  local command=$1; shift
  mkdir -p $RUNTIME_DIR $BOTTLES_DIR $CACHE_DIR/downloads $STATE_DIR $LOGS_DIR
  export_isolated_env
  case $command in
    setup|doctor|create|deps|import|run|stop|renderer|server|remove|list|audit|uninstall) cmd_$command "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"
